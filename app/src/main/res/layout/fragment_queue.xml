<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@drawable/bg_gloss_surface"
     android:clickable="true"
     android:padding="12dp"
     android:orientation="vertical"
     android:focusable="true">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="26sp"
             android:textColor="@color/text_primary"
             android:layout_weight="1"
             android:text="@string/download_queue"
             android:textStyle="bold" />

        <Button
             android:layout_height="38dp"
             android:layout_width="wrap_content"
             android:visibility="visible"
             android:textSize="11sp"
             android:strokeColor="@color/border_line"
             android:textColor="@color/text_secondary"
             style="@style/Widget.MaterialComponents.Button.OutlinedButton"
             android:id="@+id/btnDownloadSpeed"
             android:text="Download Speed · 4" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:alpha="0.6"
         android:orientation="horizontal"
         android:layout_marginTop="4dp">

        <ImageView
             android:layout_height="15dp"
             android:layout_width="15dp"
             android:src="@drawable/ic_folder_download"
             android:contentDescription="@null" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/text_secondary"
             android:layout_marginStart="5dp"
             android:text="Saved to: Download/KensakuDL" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="horizontal"
         android:layout_marginTop="8dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/text_secondary"
             android:id="@+id/tvTotal"
             android:text="Total: 0" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/color_green"
             android:layout_marginStart="16dp"
             android:id="@+id/tvDone"
             android:text="Done: 0" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/color_red"
             android:layout_marginStart="16dp"
             android:id="@+id/tvFailed"
             android:text="Failed: 0" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="@color/color_yellow"
             android:layout_marginStart="16dp"
             android:id="@+id/tvSkipped"
             android:text="Skipped: 0" />

    </LinearLayout>

    <FrameLayout
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="1"
         android:layout_marginTop="12dp">
        <androidx.recyclerview.widget.RecyclerView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:id="@+id/rvQueue" />
        <LinearLayout
             android:id="@+id/layoutQueueEmpty"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:gravity="center"
             android:orientation="vertical"
             android:padding="28dp"
             android:visibility="gone">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_folder_download" android:alpha="0.8" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Your queue is empty" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Choose an anime, select episodes, and tap Download Selected. Your progress will appear here." android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>