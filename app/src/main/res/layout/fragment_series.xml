<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/bg_surface"
     android:clickable="true"
     android:focusable="true">

    <androidx.core.widget.NestedScrollView
         android:layout_height="0dp"
         android:layout_width="0dp"
         app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toTopOf="@id/layoutDownloadBar">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="16dp"
             android:orientation="vertical">

            <Button
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="@color/text_secondary"
                 style="@style/Widget.MaterialComponents.Button.TextButton"
                 android:id="@+id/btnBack"
                 android:text="← Return to Search" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_card"
                 android:gravity="center_horizontal"
                 android:padding="16dp"
                 android:orientation="vertical">

                <ImageView
                     android:layout_height="200dp"
                     android:layout_width="140dp"
                     android:scaleType="centerCrop"
                     android:background="@color/border_subtle"
                     android:id="@+id/ivSeriesCover" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginTop="12dp"
                     android:id="@+id/tvSeriesTitle"
                     android:textStyle="bold" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:orientation="horizontal"
                     android:layout_marginTop="8dp"
                     android:id="@+id/layoutMetaPills">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:background="@drawable/bg_pill"
                         android:paddingVertical="2dp"
                         android:textSize="11sp"
                         android:textColor="@color/text_secondary"
                         android:paddingHorizontal="6dp"
                         android:id="@+id/tvYear" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:background="@drawable/bg_pill"
                         android:paddingVertical="2dp"
                         android:textSize="11sp"
                         android:textColor="@color/text_secondary"
                         android:layout_marginStart="6dp"
                         android:paddingHorizontal="6dp"
                         android:id="@+id/tvType" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:background="@drawable/bg_pill"
                         android:paddingVertical="2dp"
                         android:textSize="11sp"
                         android:textColor="@color/text_secondary"
                         android:layout_marginStart="6dp"
                         android:paddingHorizontal="6dp"
                         android:id="@+id/tvSeason" />

                </LinearLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="12sp"
                     android:textColor="@color/text_muted"
                     android:layout_marginTop="8dp"
                     android:id="@+id/tvGenres" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="16dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="15sp"
                     android:textColor="@color/text_primary"
                     android:layout_weight="1"
                     android:text="@string/episodes_title"
                     android:textStyle="bold" />

                <Button
                     android:layout_height="36dp"
                     android:layout_width="wrap_content"
                     android:textSize="11sp"
                     android:textColor="@color/text_secondary"
                     style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                     android:id="@+id/btnSelectAll"
                     android:text="@string/select_all" />

                <Button
                     android:layout_height="36dp"
                     android:layout_width="wrap_content"
                     android:textSize="11sp"
                     android:textColor="@color/text_secondary"
                     style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                     android:layout_marginStart="4dp"
                     android:id="@+id/btnClear"
                     android:text="@string/clear" />

            </LinearLayout>

            <ProgressBar
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:visibility="gone"
                 android:layout_marginTop="16dp"
                 android:indeterminateTint="@color/accent_maroon"
                 android:id="@+id/pbEpisodes"
                 android:layout_gravity="center_horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:nestedScrollingEnabled="false"
                 android:layout_marginTop="8dp"
                 android:id="@+id/rvEpisodes" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
         android:layout_height="56dp"
         android:layout_width="0dp"
         android:background="@color/header_bg"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         android:paddingHorizontal="16dp"
         android:id="@+id/layoutDownloadBar">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="13sp"
             android:textColor="@color/text_primary"
             android:layout_weight="1"
             android:id="@+id/tvSelectedCount"
             android:text="0 episodes selected" />

        <Button
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:backgroundTint="@color/accent_maroon"
             android:textColor="@color/text_primary"
             android:enabled="false"
             android:id="@+id/btnDownloadSelected"
             android:text="@string/download_selected" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>